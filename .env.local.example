# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Get these values from: https://app.supabase.com/project/_/settings/api

# Public Supabase URL (starts with https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Public Supabase Anonymous Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (PRIVATE - only for server-side API routes, DO NOT expose to client)
# Used for Stripe webhooks to bypass RLS policies
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# =============================================================================
# STRIPE CONFIGURATION (REQUIRED FOR PAYMENTS)
# =============================================================================
# Get these values from: https://dashboard.stripe.com/apikeys

# Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Stripe Monthly Price ID (from Stripe Dashboard > Products)
# This is the price ID for your $49/month subscription
STRIPE_MONTHLY_PRICE_ID=price_xxx

# Stripe Webhook Secret (for /api/webhooks/stripe)
# Get this from: https://dashboard.stripe.com/webhooks
# After creating a webhook endpoint, Stripe will provide this signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx


# =============================================================================
# APPLICATION CONFIGURATION (OPTIONAL)
# =============================================================================

# Public-facing app URL (used for SEO metadata and Stripe redirects)
# Defaults to http://localhost:3000 if not set
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# TESTING CONFIGURATION (OPTIONAL - only needed for E2E tests)
# =============================================================================

# Test user credentials for Playwright E2E tests
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123
